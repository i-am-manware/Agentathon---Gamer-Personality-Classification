# All optional — PLAYERPRINT runs with zero configuration.
PORT=3000
HOST=0.0.0.0
# Where the SQLite database (or JSON fallback file) lives
DATA_DIR=data
# auto | sqlite | json   (auto = SQLite when node:sqlite exists, else JSON file)
STORE=auto
# Set to 1 behind HTTPS so the session cookie is marked Secure
SECURE_COOKIES=0
SESSION_DAYS=30
# Seed simulated players + demo account on first boot (0 to disable)
SEED=1
SEED_PLAYERS=640
# Absolute origin used in Open Graph URLs (defaults to the request Host)
PUBLIC_URL=
