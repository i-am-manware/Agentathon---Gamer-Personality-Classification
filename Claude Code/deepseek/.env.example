# SPAWNPOINT — configuration
#
# Every value here is optional. The app runs with none of them set.
# Copy this file to `.env` and uncomment what you want to change.

# --- server ----------------------------------------------------------------
# PORT=4321
# HOST=127.0.0.1          # set to 0.0.0.0 to expose on your network

# --- storage ---------------------------------------------------------------
# DATA_DIR=./data         # where the database and session secret live

# --- sessions --------------------------------------------------------------
# If unset, a secret is generated once and persisted to data/session-secret,
# so sessions survive restarts. Set this to pin it explicitly (e.g. across
# multiple instances).
# SESSION_SECRET=change-me-to-something-long-and-random

# --- population ------------------------------------------------------------
# SEED_POPULATION=true    # seed synthetic playthroughs on first boot
# SEED_SIZE=900           # how many to generate
# POPULATION_SAMPLE_LIMIT=2400
